; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="BulletBreach"
run/main_scene="uid://dcqyp4vbobqjj"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Events="*res://scripts/autoloads/events.gd"
Globals="*res://scripts/autoloads/globals.gd"
Map="*res://scripts/autoloads/map.gd"
Enums="*res://scripts/autoloads/enums.gd"
Colors="*res://scripts/autoloads/colors.gd"
PlayerRewards="*res://scripts/autoloads/player_rewards.gd"
RunState="*res://scripts/autoloads/run_state.gd"
CurveTween="*res://scripts/autoloads/curve_tween.gd"
SceneLoader="*res://scenes/scene_loader.tscn"

[display]

window/size/viewport_width=1024
window/size/viewport_height=576
window/stretch/mode="canvas_items"

[gui]

theme/custom_font="uid://btmwvpt1xubd1"

[rendering]

textures/canvas_textures/default_texture_filter=3
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
viewport/transparent_background=true
